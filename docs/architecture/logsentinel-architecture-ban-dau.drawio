tive="1" as="geometry"><Array as="points"><mxPoint x="25" y="670"/><mxPoint x="25" y="990"/><mxPoint x="960" y="990"/></Array></mxGeometry></mxCell><mxCell id="n60" value="16 quản trị EC2 qua Session Manager (không mở cổng 22)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#879196;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n32"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="685"/><mxPoint x="120" y="960"/><mxPoint x="1410" y="960"/></Array></mxGeometry></mxCell><mxCell id="n61" value="vượt ngưỡng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#879196;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="n33" target="n35"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="670"/><mxPoint x="1700" y="290"/></Array></mxGeometry></mxCell><mxCell id="n62" value="&lt;b&gt;Luồng chính&lt;/b&gt;&lt;br&gt;1–3 Truy cập qua CloudFront + WAF tới EC2&lt;br&gt;4–5 Log web app và CloudTrail vào CloudWatch / S3&lt;br&gt;6 Detector nhận log theo thời gian thực&lt;br&gt;7 Ghi sự cố, khóa IP 24 giờ (SOAR)&lt;br&gt;8 Cảnh báo email (SNS) và Telegram&lt;br&gt;9 Đẩy IP bị khóa lên WAF mỗi phút&lt;br&gt;10 Web app tự chặn IP bị khóa, phục vụ Console&lt;br&gt;11–12 Đăng nhập Cognito; phân quyền qua Lambda&lt;br&gt;13–15 Athena truy vấn log CloudTrail trên S3&lt;br&gt;16 Quản trị máy qua SSM, không SSH&lt;br&gt;&lt;br&gt;&lt;b&gt;Ba lớp chặn IP&lt;/b&gt;: web app (60 giây) → DynamoDB (24 giờ) → WAF&lt;br&gt;&lt;br&gt;&lt;b&gt;Màu&lt;/b&gt;: xanh dương = truy cập · hồng = log · đỏ = phát hiện/phản ứng · tím = Console · xanh lá = truy vấn · xám đứt = vận hành" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#232F3E;fillColor=#FFFFFF;dashed=0;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1745" y="400" width="290" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>