[Unit]
Description=LogSentinel target web app (Gunicorn, 127.0.0.1:8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webapp
Group=webapp
WorkingDirectory=/opt/logsentinel/app
EnvironmentFile=/etc/logsentinel/runtime.env
EnvironmentFile=/etc/logsentinel/webapp.env
# Bind loopback: cong 8080 khong bao gio lo ra Internet, ke ca khi SG bi mo nham.
# Worker da luong (gthread): moi request cho AWS tra loi (Cognito, DynamoDB) chi giu 1 luong, khong giu ca
# worker. Truoc day 4 worker dong bo = 4 lan dang nhap dong thoi la het cho; nay 2 x 16 = 32 request dong thoi.
# It worker hon cung lam bo dem "chan tai cho" (nam rieng tung worker) chinh xac hon.
ExecStart=/opt/logsentinel/venv/bin/gunicorn --worker-class gthread --workers 2 --threads 16 \
    --bind 127.0.0.1:8080 --timeout 30 --keep-alive 5 'app:create_app()'
Restart=always
RestartSec=5s

# Sandbox systemd
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/log/webapp

[Install]
WantedBy=multi-user.target
