{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/webapp/access.log",
            "log_group_name": "/logsentinel/sample-app",
            "log_stream_name": "{instance_id}-webapp",
            "retention_in_days": -1
          }
        ]
      }
    }
  }
}
